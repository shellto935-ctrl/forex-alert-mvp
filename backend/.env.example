PORT=3000
NODE_ENV=development
LOG_LEVEL=info
WEBHOOK_SECRET=replace-with-a-long-random-value
DATABASE_URL=
DRY_RUN=true
MAX_DELIVERY_ATTEMPTS=6

# WhatsApp Cloud API (required only when DRY_RUN=false)
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TO=
WHATSAPP_WATCH_TEMPLATE=forex_watch_alert
WHATSAPP_ENTRY_TEMPLATE=forex_entry_ready_alert
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Twilio regular phone call fallback (ENTRY_READY only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=
